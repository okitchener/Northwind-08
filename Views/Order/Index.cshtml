@model IEnumerable<Order>
<!-- This was our problem: model IEnumerable<IdentityRole> -->

@foreach (Order o in Model)
{
  string formattedOrderDate = o.OrderDate.ToString("MM/dd/yyyy");
  string formattedRequiredDate = o.RequiredDate.ToString("MM/dd/yyyy");
  string formattedShippedDate = o.ShippedDate?.ToString("MM/dd/yyyy");
  <li>@o.OrderId - @formattedOrderDate - @formattedRequiredDate - @formattedShippedDate</li>
}
</ul>