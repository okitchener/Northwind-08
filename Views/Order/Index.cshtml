@model IEnumerable<Order>
<!-- This was our problem: model IEnumerable<IdentityRole> -->
@{
  Dictionary<int, string> customerNames = ViewBag.CustomerNames as Dictionary<int, string> ?? new Dictionary<int, string>();
  Dictionary<int, string> employeeNames = ViewBag.EmployeeNames as Dictionary<int, string> ?? new Dictionary<int, string>();
}
<div id="User" style="display:none;" data-email="@User.Identity.Name" data-employee="@User.IsInRole("northwind-employee")"></div>

 <table class="table">
  <thead>
    <tr>
         <div class="input-group">
          </select>
            <th scope="col">Order ID</th>
            <th scope="col">Customer Name</th>
            <th scope="col">Employee Name</th>
            <th scope="col">Order Date</th>
            <th scope="col">Required Date</th>
            <th scope="col">Shipped Date</th>
          <!-- <input class="form-check-input ms-2 mt-2" type="checkbox" id="Overdue">
          <label class="form-check-label ms-2 mt-1" for="Overdue">Overdue Orders</label>
          <input class="form-check-input ms-2 mt-2" type="checkbox" id="ClossToShip">
          <label class="form-check-label ms-2 mt-1" for="ClossToShip">Close to Ship</label> -->
          <input class="radio-input ms-2 mt-2" type="radio" id="All" name="filter" value="All" checked>
          <label class="form-check-label ms-2 mt-1" for="All">All Orders</label>
          <input class="radio-input ms-2 mt-2" type="radio" id="Overdue" name="filter" value="Overdue">
          <label class="form-check-label ms-2 mt-1" for="Overdue">Overdue Orders</label>
          <input class="radio-input ms-2 mt-2" type="radio" id="CloseToShip" name="filter" value="CloseToShip">
          <label class="form-check-label ms-2 mt-1" for="CloseToShip">Close to Ship</label> 
          <input class="radio-input ms-2 mt-2" type="radio" id="default" name="filter" value="Default">
          <label class="form-check-label ms-2 mt-1" for="default">Default</label>
        </div>
      </th>
    </tr>
</thead>
<tbody>
  @foreach (Order o in Model)
  {
    string OrderNameAll = "All";
    string className = "default";
    if (o.RequiredDate < DateTime.Now)
    {
      className = "overdue";
    }
    else if (o.ShippedDate == null && o.RequiredDate <= DateTime.Now.AddDays(5) && o.RequiredDate >= DateTime.Now)
    {
      className = "closeToShip";
    }
    <!-- string className = (o.RequiredDate < DateTime.Now) ? "overdue" : "";
    string closeToShipClass = (o.ShippedDate == null && o.RequiredDate <= DateTime.Now.AddDays(5))  && o.RequiredDate >= DateTime.Now ? "closeToShip" : ""; -->
    <tr class="@className @OrderNameAll">
      <td>@o.OrderId</td>
      <td>@(customerNames.TryGetValue(o.CustomerId, out var customerName) ? customerName : "-")</td>
      <td>@(employeeNames.TryGetValue(o.EmployeeId, out var employeeName) ? employeeName : "-")</td>
      <td>@o.OrderDate.ToString("MM/dd/yyyy")</td>
      <td>@o.RequiredDate.ToString("MM/dd/yyyy")</td>
      <td>@o.ShippedDate?.ToString("MM/dd/yyyy")</td>
    </tr>
  }
</tbody>
</table>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="~/order.js"></script>